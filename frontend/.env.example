# Aim-Gold Frontend Environment Variables

# Public API URL used by the browser client
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:9000

# Server-Side API URL used by Next.js SSR (e.g. inside Docker or internal network)
INTERNAL_API_URL=http://localhost:9000

# Google OAuth Client ID (must match GOOGLE_CLIENT_ID on the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
