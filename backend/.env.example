# SportConnect Backend Environment Variables

PORT=9000
MONGO_URI=mongodb://localhost:27017/aim-gold
NODE_ENV=production

# Brevo Email API Key (Required for sending OTP emails via Brevo HTTP API)
BREVO_API_KEY=xkeysib-123456789...
BREVO_SENDER_NAME=SportConnect
BREVO_SENDER_EMAIL=atharvghumtane02@gmail.com

# Cloudinary Cloud Storage (Required for persistent avatar and media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# [DEPRECATED / UNUSED] GitHub OAuth Credentials (can be revoked)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
